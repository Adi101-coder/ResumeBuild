# =============================================================================
# ResumeBuild — Environment Configuration
# Copy to .env in project root AND ensure frontend/.env.local exists
# =============================================================================

# --- Tier 1: Set these first (biggest impact) -----------------------------

# LLM resume parsing — without this, heuristic parser only (fast but shallow)
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini

# Frontend must know backend URL (also set in frontend/.env.local)
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Tier 2: Matching quality (first run downloads ~90MB model) -----------

EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- Job sources (comma-separated slugs/URLs) -----------------------------

# Greenhouse public boards: stripe,figma or Acme:acme-board
GREENHOUSE_BOARDS=stripe,figma,airbnb

# Lever companies: netflix,palantir
LEVER_COMPANIES=netflix,palantir

# Ashby boards: company:boardname
ASHBY_BOARDS=

# Career page RSS: Company:https://example.com/jobs.rss
CAREER_PAGE_FEEDS=

# Optional — required for these sources
WELLFOUND_API_TOKEN=
LINKEDIN_ACCESS_TOKEN=
TWITTER_BEARER_TOKEN=

# --- Tier 3: Tuning -------------------------------------------------------

MATCH_THRESHOLD=75
TOP_JOBS_LIMIT=50

# --- Tier 4: Local dev defaults (fine as-is) ------------------------------

DEBUG=true
DATABASE_URL=sqlite:///./resumebuild.db
# DATABASE_URL=postgresql://resumebuild:resumebuild@localhost:5432/resumebuild

# Redis/Celery — not used by core prototype yet; safe to leave
REDIS_URL=redis://localhost:6379/0

# --- Tier 5: Logging (turn down for speed after debugging) ----------------

LOG_LEVEL=DEBUG
SQL_ECHO=true
# LOG_LEVEL=INFO
# SQL_ECHO=false
